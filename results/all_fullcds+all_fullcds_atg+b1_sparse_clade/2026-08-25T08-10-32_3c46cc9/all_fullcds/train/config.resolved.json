{
  "model": "evo2_7b",
  "data": "data/all_fullcds.jsonl",
  "max_length": 1600,
  "batch_size": 4,
  "grad_accum": 8,
  "lr": 0.0001,
  "epochs": 3,
  "warmup_ratio": 0.03,
  "seed": 0,
  "val_fraction": 0.2,
  "novel_share": 0.5,
  "early_stopping_patience": 2,
  "out_dir": "out/all_fullcds/train",
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": [
      "inner_mha_cls.Wqkv",
      "inner_mha_cls.out_proj",
      "mlp.l1",
      "mlp.l2",
      "mlp.l3",
      "out_filter_dense"
    ]
  }
}